PAWE_ENV=development
PAWE_POSTGRES_PASSWORD=pawe-local-only
PAWE_DATABASE_URL=postgresql+asyncpg://pawe:pawe-local-only@localhost:5432/pawe
PAWE_BOOTSTRAP_ADMIN_USERNAME=admin
PAWE_BOOTSTRAP_ADMIN_PASSWORD=
PAWE_SESSION_TTL_HOURS=12
PAWE_SESSION_COOKIE_SECURE=false
PAWE_ALLOWED_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
PAWE_OPENAI_API_KEY=
PAWE_OPENAI_MODEL=gpt-5.6-sol
# Production must set a long, stable secret before users save personal API keys.
PAWE_AI_CREDENTIAL_ENCRYPTION_KEY=
PAWE_AI_ENABLED=false
PAWE_AI_WEEKLY_SELECTION_ENABLED=false
PAWE_AI_WEEKLY_SELECTION_MODEL=
PAWE_AI_WEEKLY_SELECTION_TIMEOUT_SECONDS=20
PAWE_AI_WEEKLY_SELECTION_MAX_OUTPUT_TOKENS=1200
PAWE_AI_WEEKLY_REVIEW_ENABLED=false
PAWE_AI_WEEKLY_REVIEW_MODEL=
PAWE_AI_WEEKLY_REVIEW_TIMEOUT_SECONDS=20
PAWE_AI_WEEKLY_REVIEW_MAX_OUTPUT_TOKENS=1000
PAWE_AI_ERROR_ATTRIBUTION_ENABLED=false
PAWE_AI_ERROR_ATTRIBUTION_MODEL=
PAWE_AI_ERROR_ATTRIBUTION_TIMEOUT_SECONDS=20
PAWE_AI_ERROR_ATTRIBUTION_MAX_OUTPUT_TOKENS=1000
PAWE_AI_RULE_EVOLUTION_ENABLED=false
PAWE_AI_RULE_EVOLUTION_MODEL=
PAWE_AI_RULE_EVOLUTION_TIMEOUT_SECONDS=20
PAWE_AI_RULE_EVOLUTION_MAX_OUTPUT_TOKENS=1200
PAWE_EXPERIMENT_ACTIVATION_ENABLED=false
PAWE_WEEKLY_PREOPEN_HOUR=8
PAWE_WEEKLY_PREOPEN_MINUTE=30
PAWE_WEEKLY_DATA_REFRESH_HOUR=18
PAWE_WEEKLY_DATA_REFRESH_MINUTE=0
PAWE_DAILY_BRIEF_HOUR=15
PAWE_DAILY_BRIEF_MINUTE=30
PAWE_JOB_POLL_SECONDS=2
