#!/bin/sh /etc/rc.common
# Independent service: never runs the stock dockerd uciadd/network rewrite.
USE_PROCD=1
START=99
STOP=10

start_service() {
    awk '$2 == "/mnt/media" && $3 == "ext4" {ok=1} END {exit !ok}' /proc/mounts || return 1
    test -f /mnt/media/projects/PAWE/config/docker-daemon.json || return 1
    procd_open_instance
    procd_set_param command /usr/bin/dockerd --config-file=/mnt/media/projects/PAWE/config/docker-daemon.json
    procd_set_param respawn 3600 10 5
    procd_set_param limits nofile="1048576 1048576"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
