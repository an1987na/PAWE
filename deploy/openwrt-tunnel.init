#!/bin/sh /etc/rc.common
USE_PROCD=1
START=99
STOP=9

start_service() {
    awk '$2 == "/mnt/media" && $3 == "ext4" {ok=1} END {exit !ok}' /proc/mounts || return 1
    test -f /mnt/media/projects/PAWE/config/tunnel/id_ed25519 || return 1
    test -f /mnt/media/projects/PAWE/config/tunnel/known_hosts || return 1
    test "$(ls -ld /mnt/media/projects/PAWE/config/tunnel/id_ed25519 | awk '{print $1}')" = '-rw-------' || return 1
    procd_open_instance
    procd_set_param command /usr/bin/ssh -NT \
        -i /mnt/media/projects/PAWE/config/tunnel/id_ed25519 \
        -o UserKnownHostsFile=/mnt/media/projects/PAWE/config/tunnel/known_hosts \
        -o StrictHostKeyChecking=yes -o BatchMode=yes -o IdentitiesOnly=yes \
        -o ConnectTimeout=15 -o ExitOnForwardFailure=yes \
        -o ServerAliveInterval=30 -o ServerAliveCountMax=3 \
        -R 127.0.0.1:18443:127.0.0.1:18080 pawe-tunnel@39.96.199.24
    procd_set_param respawn 3600 10 0
    procd_set_param stderr 1
    procd_close_instance
}
